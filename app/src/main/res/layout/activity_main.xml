<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- Top Action Bar / Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_stylish_card"
        android:gravity="center_vertical"
        android:layout_margin="12dp"
        android:padding="12dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:paddingStart="4dp"
            android:text="Status: Loading..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:clickable="true"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/btnNewChat"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_stylish_secondary"
            android:src="@drawable/baseline_add_comment_24"
            android:scaleType="centerInside"
            android:contentDescription="New Chat"
            android:padding="6dp" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_stylish_secondary"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Central Scrollable Chat Area with Bubbles Container -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Bottom Input Bar Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:background="@drawable/bg_stylish_card"
        android:elevation="6dp">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type your message..."
            android:textColor="#FFFFFF"
            android:textColorHint="#6E6E73"
            android:maxLines="3"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend"
            android:textSize="14sp"
            android:background="@drawable/bg_stylish_input"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/baseline_send_24"
            android:background="@drawable/bg_stylish_button"
            android:scaleType="centerInside"
            android:enabled="false"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
